---
import { getCollection, render } from 'astro:content';
import '../../styles/global.css';

export async function getStaticPaths() {
	const novels = await getCollection('novels');

	const publishedNovels = novels.filter(
		(novel) => novel.data.draft === false
	);

	return publishedNovels.map((novel) => ({
		params: {
			id: novel.id,
		},
		props: {
			novel,
		},
	}));
}

const { novel } = Astro.props;
const { Content } = await render(novel);

const allNovels = await getCollection('novels');

const episodes = allNovels
	.filter(
		(item) =>
			item.data.workId === novel.data.workId &&
			item.data.draft === false
	)
	.sort((a, b) => a.data.episode - b.data.episode);

const currentIndex = episodes.findIndex(
	(item) => item.id === novel.id
);

const prevEpisode =
	currentIndex > 0
		? episodes[currentIndex - 1]
		: undefined;

const nextEpisode =
	currentIndex < episodes.length - 1
		? episodes[currentIndex + 1]
		: undefined;
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex, nofollow" />

		<title>{novel.data.title} | FLaSH</title>
	</head>

	<body>
		<main>
			<a
				class="back"
				href={`/novels/works/${novel.data.workId}`}
			>
				← 目次
			</a>

			<header>
				<p class="work">
					{novel.data.work}
				</p>

				<h1>{novel.data.title}</h1>
			</header>

			<article>
				<Content />
			</article>

			<nav class="episode-nav">
				<div class="previous">
					{
						prevEpisode ? (
							<a href={`/novels/${prevEpisode.id}`}>
								<span>← PREV</span>
								<p>{prevEpisode.data.title}</p>
							</a>
						) : (
							<div class="empty"></div>
						)
					}
				</div>

				<div class="contents">
					<a href={`/novels/works/${novel.data.workId}`}>
						<span>CONTENTS</span>
						<p>目次</p>
					</a>
				</div>

				<div class="next">
					{
						nextEpisode ? (
							<a href={`/novels/${nextEpisode.id}`}>
								<span>NEXT →</span>
								<p>{nextEpisode.data.title}</p>
							</a>
						) : (
							<div class="empty"></div>
						)
					}
				</div>
			</nav>
		</main>
	</body>
</html>

<style>
	main {
		max-width: var(--reading-width);
		margin: 0 auto;
		padding: 70px 30px 120px;
	}

	header {
		margin: 80px 0;
		text-align: center;
	}

	.work {
		color: var(--text-muted);
		font-size: 0.9rem;
		margin-bottom: 20px;
	}

	h1 {
		font-size: 1.6rem;
		font-weight: normal;
		letter-spacing: 0.08em;
	}

	article {
		font-size: 1.05rem;
		line-height: 2.2;
		letter-spacing: 0.04em;
	}

	article :global(p) {
		margin: 0 0 1.8em;
	}

	.episode-nav {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: stretch;
		gap: 20px;

		margin-top: 100px;
		padding-top: 30px;

		border-top: 1px solid var(--border);
	}

	.episode-nav a {
		display: block;
		color: var(--text);
		text-decoration: none;
	}

	.episode-nav a:hover {
		opacity: 0.5;
	}

	.episode-nav span {
		display: block;
		color: var(--text-light);
		font-size: 0.7rem;
		letter-spacing: 0.15em;
		margin-bottom: 8px;
	}

	.episode-nav p {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.6;
	}

	.previous {
		text-align: left;
	}

	.contents {
		text-align: center;
		padding: 0 20px;

		border-left: 1px solid var(--border-light);
		border-right: 1px solid var(--border-light);
	}

	.next {
		text-align: right;
	}

	.empty {
		min-height: 50px;
	}

	@media (max-width: 600px) {
		main {
			padding: 50px 22px 90px;
		}

		header {
			margin: 65px 0;
		}

		h1 {
			font-size: 1.4rem;
		}

		article {
			font-size: 1rem;
			line-height: 2.1;
		}

		.episode-nav {
			grid-template-columns: 1fr 1fr;
			gap: 0;
			margin-top: 80px;
		}

		.previous,
		.next {
			padding: 20px 10px;
		}

		.contents {
			grid-column: 1 / 3;
			grid-row: 2;

			margin-top: 20px;
			padding: 20px;

			border-left: 0;
			border-right: 0;
			border-top: 1px solid var(--border-light);
		}
	}
</style>